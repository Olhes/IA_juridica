{
  "name": "ia-juridica",
  "version": "1.0.0",
  "description": "Asistente virtual bilingüe (quechua-español) para consultas de derecho digital",
  "main": "backend/main.py",
  "scripts": {
    "deps:export": "node scripts/export-requirements.mjs",
    "deps:check": "uv lock --check && node scripts/export-requirements.mjs --check",
    "test": "node scripts/run-tests.mjs offline",
    "test:python": "node scripts/run-tests.mjs python",
    "test:backend": "node scripts/run-tests.mjs backend",
    "test:scripts": "node scripts/run-tests.mjs scripts",
    "test:node": "node --test tests/scripts/unit/*.test.mjs",
    "test:frontend": "node scripts/run-tests.mjs frontend",
    "test:frontend:coverage": "node scripts/run-tests.mjs frontend-coverage",
    "test:e2e": "node scripts/run-tests.mjs e2e",
    "test:e2e:real": "node scripts/run-tests.mjs e2e-real",
    "test:coverage": "node scripts/run-tests.mjs coverage",
    "sonar": "node scripts/run-tests.mjs sonar",
    "test:all": "node scripts/run-tests.mjs all",
    "test:quality": "node scripts/run-tests.mjs quality",
    "test:quality:offline": "node scripts/run-tests.mjs quality-offline",
    "dev": "pnpm run dev:full",
    "dev:full": "node scripts/dev-full.mjs",
    "test:dev-full": "node --test tests/scripts/unit/dev-full.test.mjs",
    "frontend:dev": "pnpm --dir frontend dev",
    "frontend:build": "pnpm --dir frontend build",
    "frontend:start": "pnpm --dir frontend start",
    "backend:dev": "uv run python backend/main.py",
    "backend:dev:safe": "uv run python backend/scripts/run_dev_server.py",
    "backend:sync": "uv sync",
    "install-frontend": "pnpm --dir frontend install"
  },
  "keywords": [
    "ia",
    "juridico",
    "quechua",
    "espanol",
    "derecho-digital"
  ],
  "author": "IA Jurídica Team",
  "license": "MIT",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "packageManager": "pnpm@10.30.2",
  "pnpm": {
    "overrides": {
      "shell-quote@<1.11.0": "1.11.0",
      "undici@>=7.0.0 <7.30.1": "7.30.1"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitest/coverage-v8": "5.0.3",
    "concurrently": "^10.0.5",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vitest": "5.0.3"
  }
}

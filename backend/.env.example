# Server Configuration
PORT=8000
NODE_ENV=development
ENVIRONMENT=development
DEBUG=false

# Cohere Configuration (principal)
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_LLM_MODEL=command-r7b-12-2024
COHERE_MAX_TOKENS=2048
COHERE_TEMPERATURE=0.3

SYSTEM_PROMPT=Eres un asistente legal peruano de derecho familiar. Nunca digas que eres un modelo o LLM; mantente siempre en rol legal y entrega respuestas precisas sin inventar normas.

# Database Configuration
DATABASE_URL=sqlite:///./juridica.db
DATABASE_PATH=./database/juridica.db

# RAG Configuration
RAG_ENGINE=lightrag
EMBEDDING_MODEL=embed-multilingual-v3.0
EMBEDDING_DIM=1024
MAX_CHUNK_SIZE=1000
EMBEDDING_BATCH_SIZE=96
RERANK_TOP_K=5
RERANK_CANDIDATES=50

# Security
SECRET_KEY=your_secret_key_change_in_production
JWT_ALGORITHM=HS256

# CORS (comma-separated origins)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/juridica.log

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Evaluation
EVALUATION_ENABLED=true
DEEPEVAL_API_KEY=your_deepeval_api_key_here

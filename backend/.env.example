# Desarrollo local — rama v8, revisado 2026-10-06. No usar en producción.
ENVIRONMENT=development
DEBUG=false
APP_VERSION=v8
HOST=127.0.0.1
PORT=8000

COHERE_API_KEY=replace-with-your-cohere-key
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_LLM_MODEL=command-r7b-12-2024
COHERE_MAX_TOKENS=512
COHERE_TEMPERATURE=0.3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=96
RERANK_TOP_K=5
RERANK_CANDIDATES=50

# Backend en host, servicios Compose locales. Password SOLO de desarrollo.
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=juridica_db
DATABASE_USER=juridica_user
DATABASE_PASSWORD=juridica_password
DATABASE_URL=postgresql://juridica_user:juridica_password@localhost:5433/juridica_db
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://juridica_user:juridica_password@localhost:5433/juridica_db
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# Secretos propios e independientes; no reutilizar placeholders fuera de local.
SECRET_KEY=replace-with-a-random-jwt-secret
ANONYMOUS_SESSION_SECRET=replace-with-an-independent-random-session-secret
ANONYMOUS_SESSION_COOKIE_SAMESITE=lax
ANONYMOUS_SESSION_COOKIE_SECURE=false
ADMIN_ENDPOINTS_ENABLED=false
ADMIN_API_KEY=
API_DOCS_ENABLED=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","X-API-Key","X-Request-ID"]

RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://
LLM_RATE_LIMIT=10/minute
CONVERSATION_CREATE_RATE_LIMIT=20/hour
ADMIN_RATE_LIMIT=5/hour
TELEMETRY_RATE_LIMIT=120/minute
FEEDBACK_RATE_LIMIT=30/hour
QUALITY_RATE_LIMIT=60/minute
FEEDBACK_DIR=./data/feedback
STREAM_PIPELINE_TIMEOUT_SECONDS=120
STREAM_IDLE_TIMEOUT_SECONDS=135
SESSION_BOOTSTRAP_RATE_LIMIT=20/hour

# true solo si existe un corpus local compatible. false no asegura /ready.
LOAD_LOCAL_KG=false
NEO4J_ENABLED=false
LOG_LEVEL=INFO
LOG_FILE=./logs/juridica.log

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URI=http://localhost:3000/auth/callback

# Scanner opcional; las evaluaciones reales de tests requieren --run-model-evals.
SONAR_TOKEN=

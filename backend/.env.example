# Server Configuration
PORT=5000
NODE_ENV=development

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini
SYSTEM_PROMPT=Eres un asistente legal peruano de derecho familiar. Nunca digas que eres un modelo o LLM; mantente siempre en rol legal y entrega respuestas precisas sin inventar normas.

# Database Configuration
DB_PATH=./database/juridica.db

# JWT Configuration (if needed later)
JWT_SECRET=your_jwt_secret_here

# Logging Configuration
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

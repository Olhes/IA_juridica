</edge>
<edge source="Derecho de familia" target="Derecho familiar patrimonial">
  <data key="d7">1.0</data>
  <data key="d8">Derecho de familia encompasses various legal concepts, including derecho familiar patrimonial, which focuses on financial aspects of family law.</data>
  <data key="d9">financial aspect,legal concept</data>
  <data key="d10">chunk-51b698b915327cdd4e7a202791944718</data>
  <data key="d11">unknown_source</data>

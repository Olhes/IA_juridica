<node id="Constitution Política De La República">
  <data key="d0">Constitution Política De La República</data>
  <data key="d1">content</data>
  <data key="d2">The Constitution Política de la República is the political constitution of Peru, approved by the Congresso Constituyente Democrático del Perú and ratified by the Peruvian people in a referendum on October 31, 1993.</data>
  <data key="d3">chunk-88761817050d41565e13c98b3c5f24d3</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1783967626</data>
  <data key="d6"></data>
</node>
<node id="Peruvian People">
  <data key="d0">Peruvian People</data>
  <data key="d1">person</data>
  <data key="d2">The Peruvian people are the citizens of Peru who ratified the Constitution Política de la República in a referendum.&lt;SEP&gt;Peruvian People are the intended beneficiaries of a true democracy and the rule of law.</data>
  <data key="d3">chunk-88761817050d41565e13c98b3c5f24d3&lt;SEP&gt;chunk-a040a2ba95175664ef8bd4fa20148398</data>

<node id="Proof of Need">
  <data key="d0">Proof of Need</data>
  <data key="d1">concept</data>
  <data key="d2">Proof of need is the evidence or demonstration that an individual requires support or assistance, such as food or financial aid.</data>
  <data key="d3">chunk-4c59dfd0a7722cdd48deb0ca97fc9d04</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1783971948</data>

<node id="Omission of Family Assistance">
  <data key="d0">Omission of Family Assistance</data>
  <data key="d1">concept</data>
  <data key="d2">Omission of Family Assistance is a legal concept referring to the failure to fulfill court-ordered support obligations, particularly in the context of family law.</data>
  <data key="d3">chunk-127ae8b943be9ce7ac7a6f1a927830aa</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1783974351</data>

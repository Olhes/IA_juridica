  <data key="d0">Majority of Age</data>
  <data key="d1">concept</data>
  <data key="d2">Majority of age is the age at which a person is legally recognized as an adult, often with accompanying rights and responsibilities.</data>
  <data key="d3">chunk-4c59dfd0a7722cdd48deb0ca97fc9d04</data>
  <data key="d4">unknown_source</data>
  <data key="d5">1783971948</data>
  <data key="d6"></data>

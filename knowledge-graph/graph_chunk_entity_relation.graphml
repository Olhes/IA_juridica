  <data key="d0">Widow</data>
  <data key="d1">concept</data>
  <data key="d2">A widow is a woman whose spouse has died.&lt;SEP&gt;The term for a widow varies depending on the gender of the person being referred to.</data>
  <data key="d3">chunk-da44ae68371001162545d2e093c276a8&lt;SEP&gt;chunk-a14a99f648724916d3a3cdaf7f55100f</data>

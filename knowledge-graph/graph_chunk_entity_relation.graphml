  <data key="d1">concept</data>
  <data key="d2">Pegar, Golpear is a Spanish term that translates to "to stick, hit" and is associated with the Quechua terms Maqay and Takay.</data>
  <data key="d3">chunk-78122525030a637c72069cc1e3addbd9</data>
  <data key="d4">unknown_source</data>

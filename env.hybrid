# Configuración para modo híbrido - IA Jurídica

# PostgreSQL (local)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ia_juridica
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis (local)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Weaviate (Docker)
WEAVIATE_URL=http://localhost:8082
WEAVIATE_GRPC_URL=grpc://localhost:8083
WEAVIATE_API_KEY=

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# Aplicación
DEBUG=false
ENVIRONMENT=production
NODE_ENV=production

# Context Engineering
EMBEDDING_MODEL=cohere/multilingual-embed-v3.0
EMBEDDING_DIM=1024
CONTEXT_CACHE_TTL=3600
MAX_CONTEXT_LENGTH=8000
CONTEXT_CHUNK_SIZE=1000

# Plantilla — v8, 2026-10-06. Reemplazar TODOS los placeholders; no es deploy listo.
# Revisar OAUTH_SETUP.md y docs/SECURITY.md antes de exponer la API.
ENVIRONMENT=production
DEBUG=false
APP_VERSION=v8
HOST=0.0.0.0
PORT=8000
WORKERS=1
API_DOCS_ENABLED=false

COHERE_API_KEY=<cohere-secret>
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_LLM_MODEL=command-r7b-12-2024
COHERE_MAX_TOKENS=512
COHERE_TEMPERATURE=0.3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=96
RERANK_TOP_K=5
RERANK_CANDIDATES=50

SECRET_KEY=<independent-random-jwt-secret>
ANONYMOUS_SESSION_SECRET=<independent-random-session-secret-at-least-32-bytes>
ANONYMOUS_SESSION_COOKIE_SAMESITE=lax
ANONYMOUS_SESSION_COOKIE_SECURE=true
ADMIN_ENDPOINTS_ENABLED=false
ADMIN_API_KEY=
CORS_ORIGINS=["https://frontend.example.invalid"]
CORS_ALLOW_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
CORS_ALLOW_HEADERS=["Content-Type","X-API-Key","X-Request-ID"]

DATABASE_HOST=<private-postgres-host>
DATABASE_PORT=5432
DATABASE_NAME=<database>
DATABASE_USER=<database-user>
DATABASE_PASSWORD=<database-secret>
DATABASE_URL=postgresql://<user>:<url-encoded-password>@<host>:5432/<database>
SQLALCHEMY_DATABASE_URL=postgresql+psycopg://<user>:<url-encoded-password>@<host>:5432/<database>
# Coordinar URL y campos individuales; distintos consumidores los utilizan.
REDIS_URL=redis://:<url-encoded-password>@<private-redis-host>:6379/0
REDIS_HOST=<private-redis-host>
REDIS_PORT=6379
REDIS_PASSWORD=<redis-secret>
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=redis://:<url-encoded-password>@<private-redis-host>:6379/1
LLM_RATE_LIMIT=10/minute
CONVERSATION_CREATE_RATE_LIMIT=20/hour
ADMIN_RATE_LIMIT=5/hour
SESSION_BOOTSTRAP_RATE_LIMIT=20/hour

# Corpus/almacenamiento requieren preparación; no se provisionan con este flag.
LOAD_LOCAL_KG=false
NEO4J_ENABLED=false
LOG_LEVEL=INFO

# OAuth opcional; endurecimiento pendiente descrito en OAUTH_SETUP.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://backend.example.invalid/auth/google/callback
GOOGLE_FRONTEND_CALLBACK_URI=https://frontend.example.invalid/auth/callback

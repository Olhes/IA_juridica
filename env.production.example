# Required
COHERE_API_KEY=replace-with-your-cohere-key
OPENAI_API_KEY=replace-with-your-openai-key
SYSTEM_PROMPT=Eres un asistente legal peruano de derecho familiar. Nunca digas que eres un modelo de lenguaje o un LLM; mantente siempre en tu rol, no te salgas, y entrega respuestas precisas sin inventar normas.
SECRET_KEY=replace-with-a-long-random-secret

# Cohere model config
COHERE_EMBED_MODEL=embed-multilingual-v3.0
COHERE_RERANK_MODEL=rerank-multilingual-v3.0
COHERE_LLM_MODEL=command-r7b-12-2024
COHERE_MAX_TOKENS=2048
COHERE_TEMPERATURE=0.3
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=96

# Rerank settings
RERANK_TOP_K=5
RERANK_CANDIDATES=50

# Backend runtime
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Security
ADMIN_API_KEY=replace-with-a-long-random-key
RATE_LIMIT_PER_MINUTE=30

# CORS (JSON array for pydantic-settings list parsing)
CORS_ORIGINS=["http://localhost:3000","https://your-domain.com"]

# RAG/doc processing defaults
RAG_ENGINE=lightrag
DOCS_ROOT_DIR=./docs
RAW_PDF_DIR=./docs/raw_pdfs
PROCESSED_DIR=./docs/processed
KNOWLEDGE_GRAPH_DIR=./docs/knowledge_graph
FAILED_DIR=./docs/failed
PDF_OUTPUT_DIR=./temp/pdfs

.env*
__pycache__/
*.pyc
*.pyo
mcp.json
.vscode/
# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Python package metadata generated automatically (created by uv/pip during install)
*.egg-info/

# dependencies
/node_modules
/frontend/node_modules
/backend/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
requerimientos.md

# testing
/coverage

# next.js
/.next/
/frontend/.next/
/out/

# backend document artifacts (local-only)
/backend/docs/raw_pdfs/**
/backend/docs/processed/**
/backend/docs/knowledge_graph/**
/backend/docs/failed/**
!/backend/docs/raw_pdfs/.gitkeep
!/backend/docs/processed/.gitkeep
!/backend/docs/knowledge_graph/.gitkeep
!/backend/docs/failed/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts